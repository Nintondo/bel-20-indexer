# Example: http://localhost:19918
RPC_URL=
RPC_USER=
RPC_PASS=

# Supported: bells, doge, pepe
BLOCKCHAIN=bells
# Private shared key for /sync, including snapshot creation. Generate: openssl rand -hex 32
# Set the same value as BELLS_SYNC_TOKEN, DOGE_SYNC_TOKEN, or PEPE_SYNC_TOKEN in the overview service.
# Missing/empty disables /sync; missing/incorrect request keys return 401 before snapshot allocation.
# SYNC_TOKEN=
# [Optional] Path to the folder with blk[xxx].dat files (example: /home/<user>/.dogecoin/blocks)
BLK_DIR=
# [Optional] Path to the folder with LevelDB of node, must be copied using rsync to another folder (example: /home/<user>/.dogecoin/blocks/index copied to /home/<user>/<current_repo>/index)
INDEX_DIR=

# [Optional] (default: mainnet) (mainnet, testnet)
# NETWORK=

# [Optional] (default: 0.0.0.0:8000)
# SERVER_BIND_URL=
